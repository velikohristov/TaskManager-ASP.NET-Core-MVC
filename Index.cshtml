@model IEnumerable<Поправителен_изпит.Models.TaskItem>

@{
    ViewData["Title"] = "Моите задачи";
}

<h1>Моите задачи</h1>

<p>
    <a asp-action="Create">Добави задача</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Заглавие</th>
            <th>Описание</th>
            <th>Състояние</th>
            <th>Създадена на</th>
            <th>Краен срок</th>
            <th>Категория</th>
            <th>Приоритет</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@(item.IsCompleted ? "Завършена" : "В процес")</td>
                <td>@item.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@(item.DueDate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                <td>@(item.Category?.Name ?? "—")</td>
                <td>@(item.Priority?.Name ?? "—")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Редактирай</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Подробности</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>